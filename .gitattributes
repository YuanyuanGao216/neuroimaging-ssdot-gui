# Stable line endings for maintained first-party text only.
/main.m text eol=lf
src/**/*.m text eol=lf
src/**/*.json text eol=lf
src/**/*.py text eol=lf
src/**/*.ps1 text eol=lf
tests/**/*.m text eol=lf
tests/fixtures/*.json text eol=lf
research/*.m text eol=lf
research/*.py text eol=lf
research/compat/*.m text eol=lf
/README.md text eol=lf
/.editorconfig text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
